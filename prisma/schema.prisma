// Schema do banco de dados do app Tainted Grail.
// Estrutura da ficha baseada no corebook oficial, p.390-391 (Character Sheet)
// e p.152-209 (Character Creation, passos 1 a 10).
// Ver Tainted Grail/CLAUDE.md para as regras do projeto antes de alterar este arquivo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuários e papéis
// ---------------------------------------------------------------------------

enum Role {
  PLAYER
  GM
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(PLAYER)
  createdAt    DateTime @default(now())

  characters  CharacterSheet[]
  monsters    MonsterOrNpc[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Ficha de personagem
// ---------------------------------------------------------------------------

enum CharacterStatus {
  DRAFT
  COMPLETE
}

// As 5 Vias (Ways), p.390 da ficha oficial.
enum Way {
  AWARENESS      // Consciência
  COMBATIVENESS  // Combatividade
  CREATIVITY     // Criatividade
  CONVICTION     // Convicção
  REASON         // Razão
}

// Tipo de item de inventário.
enum ItemType {
  WEAPON
  ARMOR
  EQUIPMENT
}

model CharacterSheet {
  id     String          @id @default(cuid())
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status CharacterStatus @default(DRAFT)

  // Progresso do assistente de criação (Fase 1): última etapa concluída (0-10).
  creationStep Int @default(0)

  // --- Etapa 1: Color (p.161) ---
  color String?

  // --- Etapa 2: Origin (p.165) ---
  origin String?

  // --- Etapa 4: Occupation and Skills (p.173) ---
  occupation String?

  // --- Etapa 5: Age (p.181) ---
  age Int?

  // --- Etapa 6: Experience, Advantages, and Disadvantages (p.183) ---
  experience    Int   @default(0)
  advantages    Json?
  disadvantages Json?

  // --- Etapa 7: Equipment (p.194) --- 5 Riches iniciais.
  riches Int @default(5)

  // --- Etapa 8: character description (p.195) ---
  name        String?
  traits      Json? // { quality, flaw } — p.195-196
  personality String? // p.197
  background  String? // p.198
  description String? // aparência física, p.199

  // --- Etapa 9: other Attributes (p.201) ---
  potential           Int @default(1) // Fighting Potential (via Creativity), p.201
  defense             Int @default(0) // Awareness + Reason + 5, p.201
  speed               Int @default(0) // Awareness + Combativeness, p.202
  stamina             Int @default(10)
  survivalPoints      Int @default(3) // máximo
  survivalPointsCurrent Int? // atual (gasto em jogo) — null até a ficha ser finalizada
  mentalResistance    Int @default(0)

  // --- Saúde (p.272-279) — ficha oficial (p.390) tem 19 caixas: 5 Bem /
  // 5 Razoável / 4 Ruim / 4 Crítico / 1 Agonia. O texto corrido do
  // capítulo diz "17 caixas por padrão" (p.272) — divergência do próprio
  // livro; seguimos a ficha impressa, que bate com os exemplos numéricos
  // do texto (6 de dano = "Razoável", 11 de dano = "Ruim"). Ver
  // src/lib/health.ts.
  healthBoxesChecked Int @default(0)

  // --- Sanidade (p.280-291) — Torment/Rout são aflições nomeadas (tabela
  // de 1D10, p.288-289), não números. Guardamos o nome da aflição atual
  // (ou null se não houver nenhuma); um personagem só pode ter 1 de cada
  // por vez (p.287).
  torment String?
  rout    String?

  // --- Magia (p.310+, fora do escopo detalhado por ora — só o essencial
  // da ficha) --- Pontos de Magia: só existem após a 1ª Disciplina de
  // Magia (p.203); 6 iniciais.
  magicPoints        Int  @default(0) // máximo
  magicPointsCurrent Int? // atual
  magicForm          String? // p.391 "Form"
  magicBoon          String? // p.391 "Boon"
  magicFamiliar      String? // p.391 "Familiar/Invocation"

  // --- Ascensão/Desgraça (Character Advancement, p.210-231) — capítulo
  // ainda não implementado em detalhe; guardamos só um progresso único
  // (a ficha oficial tem 3 trilhas de 14 caixas cada, Premise/Fall,
  // Awakening/Ruin, Rise/Infamy, Ascension/Disgrace — simplificado por
  // ora, sinalizado ao usuário).
  ascensionDisgrace Int @default(0)

  // --- Etapa 10: Story Arc (p.205) — Quest + 3 Atos ---
  storyArc Json?

  // Bolsa com escolhas/metadados de criação que não são "stats" finais da
  // ficha, mas precisam ser lembrados para editar etapas anteriores
  // (domínio bonificado pela Origem, escolhas de Secundário/Terciário da
  // Ocupação, domínios de Other Pursuits, desvantagens de idade, etc).
  creationChoices Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ways   CharacterWay[]
  domains CharacterDomain[]
  items  CharacterItem[]
  rolls  DiceRollLog[]

  @@map("character_sheets")
}

// Rating das 5 Vias por personagem.
model CharacterWay {
  id          String @id @default(cuid())
  characterId String
  character   CharacterSheet @relation(fields: [characterId], references: [id], onDelete: Cascade)
  way         Way
  rating      Int    @default(0)

  @@unique([characterId, way])
  @@map("character_ways")
}

// Os ~20 Domínios da ficha oficial (p.390), cada um com Disciplinas associadas.
// domainKey usa a chave em inglês do livro (ex: "LEADERSHIP", "CLOSE_COMBAT")
// para bater exatamente com a nomenclatura oficial — ver reference/corebook_fulltext.txt p.390.
model CharacterDomain {
  id          String @id @default(cuid())
  characterId String
  character   CharacterSheet @relation(fields: [characterId], references: [id], onDelete: Cascade)
  domainKey   String
  rating      Int    @default(0)
  bonus       Int    @default(0)
  penalty     Int    @default(0)
  // Disciplinas escolhidas dentro do domínio: [{ name, rating }]
  disciplines Json?

  @@unique([characterId, domainKey])
  @@map("character_domains")
}

// Armas, armaduras e equipamento (p.391 — Weapons/Armor/Equipment).
model CharacterItem {
  id          String   @id @default(cuid())
  characterId String
  character   CharacterSheet @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type        ItemType
  name        String
  // Ex: { damage: "1D6" } para arma, { protection: 2 } para armadura.
  stats       Json?

  @@map("character_items")
}

// ---------------------------------------------------------------------------
// Mesa do Mestre
// ---------------------------------------------------------------------------

// Monstros e NPCs — visíveis e editáveis apenas por usuários com role GM.
model MonsterOrNpc {
  id            String   @id @default(cuid())
  gmId          String
  gm            User     @relation(fields: [gmId], references: [id], onDelete: Cascade)
  name          String
  wyrdnessLevel Int?
  stats         Json?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("monsters_npcs")
}

// Histórico da mesa de rolagem (comandos /teste e /atacar).
model DiceRollLog {
  id          String   @id @default(cuid())
  characterId String
  character   CharacterSheet @relation(fields: [characterId], references: [id], onDelete: Cascade)
  command     String
  breakdown   String
  result      Int
  createdAt   DateTime @default(now())

  @@map("dice_roll_logs")
}
